---
import { Icon } from "astro-icon/components";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

export interface Props {
	playerUrl: string | string[];
	playerMode?: "order" | "random";
	playerFallbackUrl?: string | string[];
	playerHlsUrl?: string;
}

const {
	playerUrl,
	playerMode = "order",
	playerFallbackUrl,
	playerHlsUrl,
} = Astro.props;

const urls = Array.isArray(playerUrl) ? playerUrl : [playerUrl];
const hasMultiple = urls.length > 1;
const urlsJson = JSON.stringify(urls);
const fallbackUrls = Array.isArray(playerFallbackUrl)
	? playerFallbackUrl
	: playerFallbackUrl
		? [playerFallbackUrl]
		: [];
const fallbackUrlsJson = JSON.stringify(fallbackUrls);
const hlsUrl = playerHlsUrl || "";

const tPrev = i18n(I18nKey.videoPrev);
const tNext = i18n(I18nKey.videoNext);
const tLoadError = i18n(I18nKey.videoLoadError);
---

{
	urls.length > 0 && (
		<div id="bg-player">
			<div
				id="bg-player-overlay"
				class="absolute inset-0 z-15 overflow-hidden pointer-events-none transition-opacity duration-500 ease-in-out opacity-0"
			>
				<video
					id="bg-player-video"
					preload="metadata"
					playsinline
					webkit-playsinline
					x5-playsinline
					x5-video-player-type="h5"
					class="size-full object-cover"
				></video>
			</div>

			<div id="bg-player-controls" class="absolute bottom-4 left-4 z-30 flex items-center gap-1.5 group">
				{hasMultiple && (
					<button
						id="bg-prev-btn"
						class="w-11 h-11 flex items-center justify-center rounded-full border border-white/30 bg-black/35 text-white/50 backdrop-blur-sm cursor-pointer transition-all duration-200 opacity-0 scale-90 group-hover:opacity-50 group-hover:scale-100 hover:opacity-80! hover:scale-100!"
						title={tPrev}
						aria-label={tPrev}
					>
						<Icon name="material-symbols:skip-previous-rounded" class="text-[1rem]" />
					</button>
				)}

				{hasMultiple && (
					<button
						id="bg-next-btn"
						class="w-11 h-11 flex items-center justify-center rounded-full border border-white/30 bg-black/35 text-white/50 backdrop-blur-sm cursor-pointer transition-all duration-200 opacity-0 scale-90 group-hover:opacity-50 group-hover:scale-100 hover:opacity-80! hover:scale-100!"
						title={tNext}
						aria-label={tNext}
					>
						<Icon name="material-symbols:skip-next-rounded" class="text-[1rem]" />
					</button>
				)}
			</div>

			<div
				id="bg-player-toast"
				class="fixed bottom-20 left-1/2 -translate-x-1/2 z-100 px-4 py-2 rounded-lg bg-black/70 text-white text-sm backdrop-blur-sm opacity-0 transition-opacity duration-300 pointer-events-none"
			>
				{tLoadError}
			</div>
		</div>
	)
}

<script is:inline define:vars={{ urls: urlsJson, playerMode, hasMultiple, fallbackUrls: fallbackUrlsJson, hlsUrl }}>
	(() => {
		var urlList = JSON.parse(urls);
		if (!urlList.length) return;
		var isMultiple = urlList.length > 1;
		var fallbackList = JSON.parse(fallbackUrls);
		var fallbackTried = false;

		// 播放链路：HLS 分片（dev, m3u8，每片几百 KB 边下边播）→ mp4（跟随域名）→ 备用 → 图片。
		// HLS 绕开 CF 不支持 Range、io 线路慢的硬伤，任意网络下小分片都能快速加载。

		var overlay = document.getElementById("bg-player-overlay");
		var video = document.getElementById("bg-player-video");
		var prevBtn = document.getElementById("bg-prev-btn");
		var nextBtn = document.getElementById("bg-next-btn");
		var toast = document.getElementById("bg-player-toast");

		if (!video) return;

		// 防止 is:inline 脚本重复注册监听器（Swup 导航会重新执行脚本）
		if (video.getAttribute("data-player-init")) return;
		video.setAttribute("data-player-init", "true");

		var isPlaying = false;
		var currentIndex = 0;
		var errorCount = 0;
		var toastTimer = null;

		function showToast() {
			if (!toast) return;
			toast.classList.remove("opacity-0");
			toast.classList.add("opacity-100");
			if (toastTimer) clearTimeout(toastTimer);
			toastTimer = setTimeout(function () {
				toast.classList.remove("opacity-100");
				toast.classList.add("opacity-0");
			}, 3000);
		}

		function pickIndex(except) {
			if (urlList.length <= 1) return 0;
			if (playerMode === "random") {
				var n;
				do { n = Math.floor(Math.random() * urlList.length); } while (n === except);
				return n;
			}
			return (except + 1) % urlList.length;
		}

		function prevIndex() {
			if (urlList.length <= 1) return 0;
			if (playerMode === "random") return pickIndex(currentIndex);
			return (currentIndex - 1 + urlList.length) % urlList.length;
		}

		function syncAttr() {
			document.body.toggleAttribute("data-bg-video-playing", isPlaying);
			document.documentElement.toggleAttribute("data-bg-video-playing", isPlaying);
			window.dispatchEvent(new CustomEvent("bg-player-state-change", { detail: { playing: isPlaying } }));
		}

		function getCurrentUrl() {
			// 备用源已启用时读备用列表（主源全部失败后的兜底）
			if (fallbackTried) return fallbackList[currentIndex % fallbackList.length];
			return urlList[currentIndex];
		}

				var hlsInstance = null;

			function destroyHls() {
				if (hlsInstance) {
					try { hlsInstance.destroy(); } catch (e) {}
					hlsInstance = null;
				}
			}

			// mp4 直播（原逻辑拆出）
			function playMp4(url) {
				destroyHls();
				video.src = url;
				video.muted = true;
				video.play()
					.then(function () { setTimeout(function () { if (video) video.muted = false; }, 100); })
					.catch(function () { isPlaying = false; syncAttr(); });
			}

			// HLS 分片播放：绕开 CF 无 Range 只能整包下载的硬伤，每片几百 KB 边下边播
			function playHls(url, onFail) {
				function startWith(Hls) {
					if (!Hls.isSupported()) { onFail(); return; }
					destroyHls();
					try {
						hlsInstance = new Hls({ maxBufferLength: 40, maxMaxBufferLength: 120 });
						hlsInstance.loadSource(url);
						hlsInstance.attachMedia(video);
						hlsInstance.on(Hls.Events.MANIFEST_PARSED, function () {
							video.muted = true;
							video.play()
								.then(function () { setTimeout(function () { if (video) video.muted = false; }, 100); })
								.catch(function () { isPlaying = false; syncAttr(); });
						});
						hlsInstance.on(Hls.Events.ERROR, function (evt, data) {
							if (data && data.fatal) {
								// HLS 致命错误 → 退回 mp4 播放
								destroyHls();
								onFail();
							}
						});
					} catch (e) { onFail(); }
				}
				// is:inline 脚本不走打包，用站点根绝对路径加载 public 下的 hls.min.js（UMD，挂 window.Hls）
				if (window.Hls) { startWith(window.Hls); return; }
				import('/assets/js/hls.min.js')
					.then(function (mod) {
						var Hls = mod.default || window.Hls;
						if (!Hls) { onFail(); return; }
						startWith(Hls);
					})
					.catch(function () { onFail(); });
			}

		function doPlay() {
				var url = getCurrentUrl();
				// 单视频 + 有 HLS 配置 + 未启用备用源时优先走 HLS（多视频列表仍走 mp4）
				if (hlsUrl && !isMultiple && !fallbackTried) {
					playHls(hlsUrl, function () { playMp4(url); });
				} else {
					playMp4(url);
				}
			}

		function switchTrack(index) {
			// 手动切歌（多视频模式）：切回主列表，重置备用状态
			if (fallbackTried) {
				fallbackTried = false;
				errorCount = 0;
			}
			if (index < 0 || index >= urlList.length) return;
			currentIndex = index;
			if (isPlaying) {
				doPlay();
			} else {
				video.src = urlList[currentIndex];
				video.load();
			}
		}

		// 播放时横幅拉长（bg-video-active），暂停/结束恢复原高度
		function setBgActive(active) {
			var w = document.getElementById("wallpaper-wrapper");
			if (!w) return;
			if (active) { w.classList.add("bg-video-active"); }
			else { w.classList.remove("bg-video-active"); }
		}

		// 进入首页（点击导航"主页"按钮 / 首次加载首页）时背景拉长：加载时拉长效果，离开首页恢复
		function applyHomeStretch() {
			var isHome = location.pathname === "/" || location.pathname === "/index.html";
			var w = document.getElementById("wallpaper-wrapper");
			if (!w) return;
			if (isHome) { w.classList.add("bg-home-active"); }
			else { w.classList.remove("bg-home-active"); }
		}
		applyHomeStretch();
		// Swup 无刷新导航后重算（覆盖：从其他页点击"主页"返回首页、首次加载）
		document.addEventListener("swup:page:view", applyHomeStretch);
		document.addEventListener("swup:contentReplaced", applyHomeStretch);
		document.addEventListener("swup:content:replace", applyHomeStretch);
		if (typeof window !== "undefined" && window.swup && window.swup.hooks) {
			window.swup.hooks.on("page:view", applyHomeStretch);
		}

		// 已经在首页时再点导航"主页"按钮：背景"跳动"加载动画
		// 只对背景 wrapper 做 scaleY 脉冲（transform，不受 height!important 影响），
		// 内容区完全不动、无透明度变化、无起点跳变，视觉上只有一次连贯"跳动"
		// （页面切换场景由 applyHomeStretch 处理；这里是同页点击，无导航事件）
		document.addEventListener("click", function (e) {
			var a = e.target && e.target.closest ? e.target.closest("a[href]") : null;
			if (!a) return;
			var href = a.getAttribute("href") || "";
			var path;
			try { path = new URL(href, location.href).pathname; }
			catch (err) { path = href.split("#")[0].split("?")[0]; }
			var isHomeLink = path === "/" || path === "/index.html";
			if (!isHomeLink) return;
			// 不在首页时交给 applyHomeStretch（页面切换自带拉长），这里只处理同页点击
			if (location.pathname !== "/" && location.pathname !== "/index.html") return;
			var w = document.getElementById("wallpaper-wrapper");
			if (!w) return;
			if (w.classList.contains("home-jumping")) return; // 动画进行中，忽略重复点击
			w.classList.add("home-jumping");
			var cleanup = function () {
				w.classList.remove("home-jumping");
				w.removeEventListener("animationend", cleanup);
			};
			w.addEventListener("animationend", cleanup);
			setTimeout(function () {
				if (w.classList.contains("home-jumping")) cleanup();
			}, 1600);
		}, true);

		function toggle() {
			isPlaying = !isPlaying;
			if (isPlaying) {
				if (currentIndex >= urlList.length) currentIndex = 0;
				syncAttr();
				if (overlay) { overlay.classList.remove("opacity-0"); overlay.classList.add("opacity-100"); }
				setBgActive(true);
				doPlay();
			} else {
				video.pause();
				if (overlay) { overlay.classList.remove("opacity-100"); overlay.classList.add("opacity-0"); }
				setBgActive(false);
				syncAttr();
			}
		}

		function onEnded() {
			if (isMultiple) {
				currentIndex = pickIndex(currentIndex);
				doPlay();
			} else {
				isPlaying = false;
				if (overlay) { overlay.classList.remove("opacity-100"); overlay.classList.add("opacity-0"); }
				setBgActive(false);
				syncAttr();
			}
		}

		function onError() {
			errorCount++;
			if (isMultiple && !fallbackTried && errorCount < urlList.length) {
				// 多视频模式：主列表内自动尝试下一个
				currentIndex = pickIndex(currentIndex);
				video.src = urlList[currentIndex];
				video.load();
			} else if (!fallbackTried && fallbackList.length) {
				// 主源全部失败 → 切到备用视频（io 挂了走 dev，不退回图片）
				fallbackTried = true;
				currentIndex = 0;
				errorCount = 0;
				doPlay();
			} else if (fallbackTried && fallbackList.length > 1 && errorCount < fallbackList.length) {
				// 备用源也是多个 → 依次尝试
				currentIndex = (currentIndex + 1) % fallbackList.length;
				doPlay();
			} else {
				// 全部失败 → 退回图片壁纸
				isPlaying = false;
				if (overlay) { overlay.classList.remove("opacity-100"); overlay.classList.add("opacity-0"); }
				setBgActive(false);
				syncAttr();
				showToast();
			}
		}

		// 监听导航栏播放按钮事件
		window.addEventListener("bg-player-toggle", toggle);
		video.addEventListener("ended", onEnded);
		video.addEventListener("error", onError);
		// 播放成功时重置错误计数
		video.addEventListener("playing", function () { errorCount = 0; });
		if (prevBtn) prevBtn.addEventListener("click", function () { switchTrack(prevIndex()); });
		if (nextBtn) nextBtn.addEventListener("click", function () { switchTrack(pickIndex(currentIndex)); });

		// 切换壁纸模式时停止播放
		window.addEventListener("wallpaperModeChange", function (e) {
			if (e.detail && e.detail.mode === "none" && isPlaying) {
				isPlaying = false;
				video.pause();
				if (overlay) { overlay.classList.remove("opacity-100"); overlay.classList.add("opacity-0"); }
				syncAttr();
			}
		});

		// 动态控制 prev/next 按钮显示
		if (!isMultiple) {
			if (prevBtn) prevBtn.style.display = "none";
			if (nextBtn) nextBtn.style.display = "none";
		}

		function cleanup() {
			// 视频仍在播放时保留属性，供 Navbar 同步按钮状态
			if (!isPlaying) {
				document.body.removeAttribute("data-bg-video-playing");
				document.documentElement.removeAttribute("data-bg-video-playing");
			}
		}
		document.addEventListener("astro:before-swap", cleanup);
	})();
</script>

<style>
	:global([data-bg-video-playing] #banner-images-container),
	:global([data-bg-video-playing] #banner-dim-container),
	:global([data-bg-video-playing] #banner-overlay-container),
	:global([data-bg-video-playing] #header-waves),
	:global([data-bg-video-playing] #wallpaper-gradient) {
		opacity: 0 !important;
		transition: opacity 0.5s ease;
	}
</style>
