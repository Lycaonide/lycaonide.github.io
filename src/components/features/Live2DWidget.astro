---
import { url } from "@/utils/url-utils";

interface MenuItem {
	icon?: string;
	label: string;
	action: string;
}

interface Props {
	config: {
		enable: boolean;
		model:
			| {
					path: string;
					volume?: number;
					scale?: number;
					x?: number;
					y?: number;
			  }
			| {
					path: string;
					volume?: number;
					scale?: number;
					x?: number;
					y?: number;
			  }[];
		position?: "bottom-left" | "bottom-right";
		size?: number | { width: number; height: number };
		primaryColor?: string;
		transitionDuration?: number;
		transitionType?: "slide" | "fade";
		menus?: {
			items?: MenuItem[];
			extraItems?: MenuItem[];
			align?: "left" | "right";
		};
		tips?: {
			enable?: boolean;
			welcomeMessage?: string[];
			messages?: string[];
			duration?: number;
			interval?: number;
			offset?: { x?: number; y?: number };
			typing?: {
				param?: string;
				speed?: number;
				minValue?: number;
				maxValue?: number;
			};
		};
		responsive?: {
			hideOnMobile?: boolean;
			mobileBreakpoint?: number;
		};
	};
}

const { config } = Astro.props;

// 构建模型配置
const models = Array.isArray(config.model) ? config.model : [config.model];
const resolvePath = (p: string) => (/^https?:\/\//.test(p) ? p : url(p));

// 容器尺寸（oh-my-live2d 舞台尺寸）：number 视为正方形，对象取宽高
const sizeRaw = config.size ?? 300;
const sizeW = typeof sizeRaw === "number" ? sizeRaw : sizeRaw.width ?? 300;
const sizeH = typeof sizeRaw === "number" ? sizeRaw : sizeRaw.height ?? 300;

const modelConfigs = models.map((m) => ({
	path: resolvePath(m.path),
	...(m.volume !== undefined && { volume: m.volume }),
	...(m.scale !== undefined && { scale: m.scale }),
	...((m.x !== undefined || m.y !== undefined) && {
		offset: [m.x ?? 0, m.y ?? 0],
	}),
}));

// 序列化菜单配置（只保留 icon, label, action）
function serializeMenus(menus: Props["config"]["menus"]) {
	if (!menus) return {};
	const serialize = (items: MenuItem[]) =>
		items.map(({ icon, label, action }) => ({ icon, label, action }));
	const result: {
		items?: ReturnType<typeof serialize>;
		extraItems?: ReturnType<typeof serialize>;
		align?: string;
	} = {};
	if (menus.items) result.items = serialize(menus.items);
	if (menus.extraItems) result.extraItems = serialize(menus.extraItems);
	if (menus.align) result.align = menus.align;
	return result;
}
---

<div
	id="l2d-widget-container"
	style={`position: fixed; left: 0; bottom: 0; z-index: 999; width: ${sizeW}px; height: ${sizeH}px;`}
	data-models={JSON.stringify(modelConfigs)}
	data-position={config.position || "bottom-left"}
	data-size={JSON.stringify(config.size || 300)}
	data-primary-color={config.primaryColor || ""}
	data-transition-duration={config.transitionDuration?.toString() || ""}
	data-transition-type={config.transitionType || ""}
	data-menus={JSON.stringify(serializeMenus(config.menus))}
	data-tips={JSON.stringify(config.tips || {})}
	data-responsive={JSON.stringify(config.responsive || {})}
>
</div>

<script>
	import { loadOml2d } from "oh-my-live2d";

	// ---- 读容器配置（由 pioConfig.ts 序列化而来） ----
	const container = document.getElementById("l2d-widget-container");
	if (!container) {
		throw new Error("l2d-widget-container not found");
	}
	const models = JSON.parse(container.dataset.models || "[]");
	const menus = JSON.parse(container.dataset.menus || "{}");
	const tips = JSON.parse(container.dataset.tips || "{}");
	const responsive = JSON.parse(container.dataset.responsive || "{}");
	const position = container.dataset.position || "bottom-left";
	const primaryColor = container.dataset.primaryColor || "#67c23a";

	// 响应式：移动端隐藏
	function applyResponsive() {
		if (responsive.hideOnMobile) {
			const bp = responsive.mobileBreakpoint || 768;
			container.style.display =
				window.innerWidth <= bp ? "none" : "";
		} else {
			container.style.display = "";
		}
	}
	applyResponsive();

	// ---- 模型转换（oh-my-live2d 格式） ----
	// l2d-widget 的 scale=1 表示原始大小；oh-my-live2d 默认 0.1，舞台 200px 下 scale>=1 会导致渲染异常，
	// 因此把 >=0.5 的 scale 统一归一为 0.07（比默认更小一号，适配小尺寸观感），小 scale 保留原值
	const omlModels = models.map((m: any) => ({
		name: m.path.split("/").pop() || m.path,
		path: m.path,
		scale: m.scale && m.scale < 0.5 ? m.scale : 0.07,
		// 窄视口(<768px)走 mobileScale，桌面走 scale；两处保持一致才能在任何宽度下人物大小统一
		mobileScale: m.scale && m.scale < 0.5 ? m.scale : 0.07,
		position: m.offset || [0, 0],
		volume: m.volume ?? 0.5,
		motionPreloadStrategy: "ALL" as const,
	}));

	// 内置 iconfont 图标（oh-my-live2d）
	const ICONS: Record<string, string> = {
		home: "icon-about",
		scrollToTop: "icon-setting",
		sleep: "icon-rest",
		switchModel: "icon-switch",
		github: "icon-like",
	};

	// 菜单动作
	const actions: Record<string, (oml2d: any) => void> = {
		home: () => (window.location.href = "/"),
		scrollToTop: () => window.scrollTo({ top: 0, behavior: "smooth" }),
		sleep: (oml2d) => {
			oml2d.stageSlideOut();
			oml2d.statusBarPopup("看板娘休息中…", 10000, primaryColor);
			oml2d.setStatusBarClickEvent(() => {
				oml2d.stageSlideIn();
				oml2d.statusBarClose("", 0, primaryColor);
				oml2d.statusBarClearEvents();
			});
		},
		github: () => window.open("https://github.com/lycaonide", "_blank"),
		switchModel: async (oml2d) => {
			const n = omlModels.length;
			if (n <= 1) return;
			let idx = Math.floor(Math.random() * n);
			if (idx === oml2d.modelIndex) idx = (idx + 1) % n;
			await oml2d.loadModelByIndex(idx);
		},
	};

	const menuItems = (menus.items || []).map((item: any) => ({
		id: item.action,
		title: item.label,
		icon: ICONS[item.action] || "icon-about",
		onClick: (oml2d: any) => actions[item.action]?.(oml2d),
	}));

	// ---- 提示气泡（闲置消息；欢迎语在 onLoad 成功后手动显示） ----
	const tipsConfig: any = {};
	if (tips.enable !== false) {
		if (tips.messages && tips.messages.length) {
			tipsConfig.idleTips = {
				message: tips.messages,
				duration: tips.duration || 3000,
				interval: tips.interval || 8000,
			};
		}
	}

	// ---- 初始化 ----
	const oml2d = loadOml2d({
		parentElement: container,
		dockedPosition: position === "bottom-right" ? "right" : "left",
		primaryColor,
		transitionTime: 500,
		// mobileDisplay: 移动端显隐已由上方 applyResponsive（hideOnMobile）控制容器，
		// 库侧固定 true，避免窄视口下舞台被静默隐藏（canvas 高度为 0）
		mobileDisplay: true,
		models: omlModels,
		menus: {
			items: menuItems,
			// 按钮：30px 圆形，图标同比例
			itemStyle: {
				width: "30px",
				height: "30px",
				fontSize: "16px",
				borderRadius: "50%",
			},
			mobileItemStyle: {
				width: "30px",
				height: "30px",
				fontSize: "16px",
				borderRadius: "50%",
			},
		},
		tips: {
			...tipsConfig,
			// 气泡：圆角胶囊、更短更窄、上移避免被人物/动物遮挡
			style: {
				fontSize: "12px",
				minHeight: "56px",
				maxWidth: "120px",
				padding: "6px 14px",
				lineHeight: "1.5",
				borderRadius: "20px",
				marginTop: "-16px",
			},
			mobileStyle: {
				fontSize: "12px",
				minHeight: "56px",
				maxWidth: "120px",
				padding: "6px 14px",
				lineHeight: "1.5",
				borderRadius: "20px",
				marginTop: "-16px",
			},
		},
		statusBar: {
			loadingMessage: "加载中",
			loadSuccessMessage: "加载完成",
			loadFailMessage: "加载失败，点击重试",
			restMessage: "看板娘休息中",
			switchingMessage: "切换中",
			// 状态条：更小更圆
			style: {
				fontSize: "12px",
				minHeight: "26px",
				padding: "2px 10px",
				borderRadius: "13px",
				top: "0px",
				bottom: "auto",
				left: "0px",
			},
			mobileStyle: {
				fontSize: "12px",
				minHeight: "26px",
				padding: "2px 10px",
				borderRadius: "13px",
				top: "0px",
				bottom: "auto",
				left: "0px",
			},
		},
	});

	// 欢迎语：模型加载成功后随机显示一条
	if (tips.enable !== false && tips.welcomeMessage && tips.welcomeMessage.length) {
		oml2d.onLoad((status: string) => {
			if (status === "success") {
				const msg =
					tips.welcomeMessage[Math.floor(Math.random() * tips.welcomeMessage.length)];
				oml2d.tipsMessage(msg, 4000, 10);
			}
		});
	}

	// 窗口尺寸变化时重新判断移动端隐藏
	window.addEventListener("resize", () => applyResponsive());

	// ---- 人物可移动：按住人物/气泡/提示区域拖动，舞台、菜单、气泡、状态条整体平移 ----
	// 不拦截菜单按钮点击；位移超过阈值才视为拖动（保留模型点击交互）
	let dragState: {
		els: { el: HTMLElement; left: number; top: number }[];
		startX: number;
		startY: number;
		active: boolean;
	} | null = null;
	const DRAG_THRESHOLD = 6;

	function collectDragEls(): { el: HTMLElement; left: number; top: number }[] {
		const ids = ["oml2d-stage", "oml2d-menus", "oml2d-tips", "oml2d-statusBar"];
		return ids
			.map((id) => container.querySelector<HTMLElement>(`#${id}`))
			.filter((el): el is HTMLElement => !!el)
			.map((el) => {
				const r = el.getBoundingClientRect();
				return { el, left: r.left, top: r.top };
			});
	}

	// 捕获阶段：即使元素 fixed 定位超出容器视觉边界也能收到事件
	container.addEventListener(
		"pointerdown",
		(e) => {
			if ((e.target as HTMLElement).closest("#oml2d-menus")) return;
			dragState = {
				startX: e.clientX,
				startY: e.clientY,
				active: false,
				els: collectDragEls(),
			};
		},
		true,
	);

	window.addEventListener(
		"pointermove",
		(e) => {
			if (!dragState || !dragState.els.length) return;
			const dx = e.clientX - dragState.startX;
			const dy = e.clientY - dragState.startY;
			if (!dragState.active && Math.hypot(dx, dy) > DRAG_THRESHOLD) {
				dragState.active = true;
			}
			if (!dragState.active) return;
			for (const it of dragState.els) {
				it.el.style.left = `${it.left + dx}px`;
				it.el.style.top = `${it.top + dy}px`;
				it.el.style.right = "auto";
				it.el.style.bottom = "auto";
			}
			e.preventDefault();
		},
		{ passive: false },
	);

	function endDrag() {
		dragState = null;
	}
	window.addEventListener("pointerup", endDrag);
	window.addEventListener("pointercancel", endDrag);
</script>
