---
import { url } from "@/utils/url-utils";

interface MenuItem {
	icon?: string;
	label: string;
	action: string;
}

interface Props {
	config: {
		enable: boolean;
		model:
			| {
					path: string;
					volume?: number;
					scale?: number;
					x?: number;
					y?: number;
			  }
			| {
					path: string;
					volume?: number;
					scale?: number;
					x?: number;
					y?: number;
			  }[];
		position?: "bottom-left" | "bottom-right";
		size?: number | { width: number; height: number };
		primaryColor?: string;
		transitionDuration?: number;
		transitionType?: "slide" | "fade";
		menus?: {
			items?: MenuItem[];
			extraItems?: MenuItem[];
			align?: "left" | "right";
		};
		tips?: {
			enable?: boolean;
			welcomeMessage?: string[];
			messages?: string[];
			duration?: number;
			interval?: number;
			offset?: { x?: number; y?: number };
			typing?: {
				param?: string;
				speed?: number;
				minValue?: number;
				maxValue?: number;
			};
		};
		responsive?: {
			hideOnMobile?: boolean;
			mobileBreakpoint?: number;
		};
	};
}

const { config } = Astro.props;

// 构建模型配置
const models = Array.isArray(config.model) ? config.model : [config.model];
const resolvePath = (p: string) => (/^https?:\/\//.test(p) ? p : url(p));

// 容器尺寸（oh-my-live2d 舞台尺寸）：number 视为正方形，对象取宽高
const sizeRaw = config.size ?? 300;
const sizeW = typeof sizeRaw === "number" ? sizeRaw : sizeRaw.width ?? 300;
const sizeH = typeof sizeRaw === "number" ? sizeRaw : sizeRaw.height ?? 300;

const modelConfigs = models.map((m) => ({
	path: resolvePath(m.path),
	...(m.volume !== undefined && { volume: m.volume }),
	...(m.scale !== undefined && { scale: m.scale }),
	...((m.x !== undefined || m.y !== undefined) && {
		offset: [m.x ?? 0, m.y ?? 0],
	}),
}));

// 序列化菜单配置（只保留 icon, label, action）
function serializeMenus(menus: Props["config"]["menus"]) {
	if (!menus) return {};
	const serialize = (items: MenuItem[]) =>
		items.map(({ icon, label, action }) => ({ icon, label, action }));
	const result: {
		items?: ReturnType<typeof serialize>;
		extraItems?: ReturnType<typeof serialize>;
		align?: string;
	} = {};
	if (menus.items) result.items = serialize(menus.items);
	if (menus.extraItems) result.extraItems = serialize(menus.extraItems);
	if (menus.align) result.align = menus.align;
	return result;
}
---

<div
	id="l2d-widget-container"
	style={`position: fixed; left: 0; bottom: 0; z-index: 999; width: ${sizeW}px; height: ${sizeH}px;`}
	data-models={JSON.stringify(modelConfigs)}
	data-position={config.position || "bottom-left"}
	data-size={JSON.stringify(config.size || 300)}
	data-primary-color={config.primaryColor || ""}
	data-transition-duration={config.transitionDuration?.toString() || ""}
	data-transition-type={config.transitionType || ""}
	data-menus={JSON.stringify(serializeMenus(config.menus))}
	data-tips={JSON.stringify(config.tips || {})}
	data-responsive={JSON.stringify(config.responsive || {})}
>
</div>

<script>
	import { loadOml2d } from "oh-my-live2d";

	// Swup 无刷新导航后组件 DOM 被替换，需重新初始化；旧 window 监听因容器断开自动失效
	let lastWidgetContainer: HTMLElement | null = null;
	function initWidget() {
	
	
		// ---- 读容器配置（由 pioConfig.ts 序列化而来） ----
		const container = document.getElementById("l2d-widget-container");
		if (!container) {
			throw new Error("l2d-widget-container not found");
		}
		const models = JSON.parse(container.dataset.models || "[]");
		const menus = JSON.parse(container.dataset.menus || "{}");
		const tips = JSON.parse(container.dataset.tips || "{}");
		const responsive = JSON.parse(container.dataset.responsive || "{}");
		const position = container.dataset.position || "bottom-left";
		const primaryColor = container.dataset.primaryColor || "#67c23a";
	
		// 响应式：移动端隐藏
		function applyResponsive() {
			if (responsive.hideOnMobile) {
				const bp = responsive.mobileBreakpoint || 768;
				container.style.display =
					window.innerWidth <= bp ? "none" : "";
			} else {
				container.style.display = "";
			}
		}
		applyResponsive();
	
		// ---- 模型转换（oh-my-live2d 格式） ----
		// l2d-widget 的 scale=1 表示原始大小；oh-my-live2d 默认 0.1，舞台 200px 下 scale>=1 会导致渲染异常，
		// 因此把 >=0.5 的 scale 统一归一为 0.07（比默认更小一号，适配小尺寸观感），小 scale 保留原值
		const omlModels = models.map((m: any) => ({
			name: m.path.split("/").pop() || m.path,
			path: m.path,
			scale: m.scale && m.scale < 0.5 ? m.scale : 0.07,
			// 窄视口(<768px)走 mobileScale，桌面走 scale；两处保持一致才能在任何宽度下人物大小统一
			mobileScale: m.scale && m.scale < 0.5 ? m.scale : 0.07,
			position: m.offset || [0, 0],
			volume: m.volume ?? 0.5,
			motionPreloadStrategy: "ALL" as const,
		}));
	
		// 内置 iconfont 图标（oh-my-live2d）
		const ICONS: Record<string, string> = {
			home: "icon-about",
			scrollToTop: "icon-setting",
			sleep: "icon-rest",
			switchModel: "icon-switch",
			github: "icon-like",
		};
	
		// 菜单动作
		const actions: Record<string, (oml2d: any) => void> = {
			home: () => {
				// 已在首页：不重复跳转（避免刷新白屏）
				if (window.location.pathname === "/") return;
				// Swup 无刷新导航会导致看板娘组件不重建而消失，改用淡出过渡 + 整页跳转
				document.body.style.transition = "opacity 0.2s ease";
				document.body.style.opacity = "0";
				window.setTimeout(() => {
					window.location.href = "/";
				}, 200);
			},
			scrollToTop: () => window.scrollTo({ top: 0, behavior: "smooth" }),
			sleep: (oml2d) => {
				oml2d.stageSlideOut();
				oml2d.clearTips();
				oml2d.statusBarPopup("休息中", 10000, primaryColor);
				oml2d.setStatusBarClickEvent(() => {
					oml2d.stageSlideIn();
					oml2d.statusBarClose("", 0, primaryColor);
					oml2d.statusBarClearEvents();
				});
			},
			github: () => window.open("https://github.com/lycaonide", "_blank"),
							switchModel: async (oml2d) => {
					const n = omlModels.length;
					if (n <= 1) return;
					let idx = Math.floor(Math.random() * n);
					if (idx === oml2d.modelIndex) idx = (idx + 1) % n;
					// 记录拖动状态与四元素位置快照：切换模型后保持整体位置不跳回初始
					const stage0 = container.querySelector<HTMLElement>("#oml2d-stage");
					const dragged = !!(stage0 && stage0.style.left);
					const snap: Record<string, { left: string; top: string; bottom: string; right: string }> = {};
					for (const id of ["oml2d-stage", "oml2d-menus", "oml2d-tips", "oml2d-statusBar"]) {
						const el = container.querySelector<HTMLElement>(`#${id}`);
						if (el) snap[id] = { left: el.style.left, top: el.style.top, bottom: el.style.bottom, right: el.style.right };
					}
					await oml2d.loadModelByIndex(idx);
					if (dragged) {
						// 拖动过：恢复整体位置（库 reloadStyle 会重置样式，切换后拉回快照）
						for (const [id, st] of Object.entries(snap)) {
							const el = container.querySelector<HTMLElement>(`#${id}`);
							if (!el) continue;
							if (st.left) el.style.left = st.left;
							if (st.top) el.style.top = st.top;
							if (st.bottom) el.style.bottom = st.bottom;
							if (st.right) el.style.right = st.right;
						}
					} else {
						// 未拖动：正常锚定（状态栏腰部、按钮栏最右）
						syncStatusBarPos();
						syncMenusPos();
					}
				}
		};
	
		const menuItems = (menus.items || []).map((item: any) => ({
			id: item.action,
			title: item.label,
			icon: ICONS[item.action] || "icon-about",
			onClick: (oml2d: any) => actions[item.action]?.(oml2d),
		}));
	
		// ---- 提示气泡（闲置消息；欢迎语在 onLoad 成功后手动显示） ----
		const tipsConfig: any = {};
		if (tips.enable !== false) {
			if (tips.messages && tips.messages.length) {
				tipsConfig.idleTips = {
					message: tips.messages,
					duration: tips.duration || 3000,
					interval: tips.interval || 8000,
				};
			}
		}
	
		// ---- 初始化 ----
		const oml2d = loadOml2d({
			parentElement: container,
			dockedPosition: position === "bottom-right" ? "right" : "left",
			primaryColor,
			transitionTime: 500,
			// mobileDisplay: 移动端显隐已由上方 applyResponsive（hideOnMobile）控制容器，
			// 库侧固定 true，避免窄视口下舞台被静默隐藏（canvas 高度为 0）
			mobileDisplay: true,
			sayHello: false,
			models: omlModels,
			menus: {
				items: menuItems,
				// 按键：相对舞台右移出界，离人物更远
				style: {
					right: "-30px",
				},
				mobileStyle: {
					right: "-30px",
				},
				// 按钮：30px 圆形，图标同比例
				itemStyle: {
					width: "30px",
					height: "30px",
					fontSize: "16px",
					borderRadius: "50%",
				},
				mobileItemStyle: {
					width: "30px",
					height: "30px",
					fontSize: "16px",
					borderRadius: "50%",
				},
			},
			tips: {
				...tipsConfig,
				// 气泡：圆角胶囊、更短更窄、上移避免被人物/动物遮挡
				style: {
					fontSize: "12px",
					minHeight: "110px",
					maxWidth: "200px",
					padding: "12px 14px",
					lineHeight: "1.6",
					borderRadius: "20px",
					marginTop: "-90px",
				},
				mobileStyle: {
					fontSize: "12px",
					minHeight: "110px",
					maxWidth: "200px",
					padding: "12px 14px",
					lineHeight: "1.6",
					borderRadius: "20px",
					marginTop: "-90px",
				},
			},
			statusBar: {
				loadingMessage: "加载中",
				loadSuccessMessage: "加载完成",
				loadFailMessage: "加载失败，点击重试",
				restMessage: "休息中",
				switchingMessage: "切换中",
				// 状态条：更小更圆
				style: {
					fontSize: "12px",
					minHeight: "26px",
					padding: "2px 10px",
					borderRadius: "13px",
					bottom: "100px",
					left: "0px",
				},
				mobileStyle: {
					fontSize: "12px",
					minHeight: "26px",
					padding: "2px 10px",
					borderRadius: "13px",
					bottom: "100px",
					left: "0px",
				},
			},
		});
	
					// 禁用库内置时段问候（早上好/晚上好等），只显示我们自己的欢迎语
			if (oml2d.tips) oml2d.tips.welcome = () => {};

// 状态条跟随人物：锚定在人物头顶上方（模型加载后按实际高度修正）
		// 状态栏固定位置（所有模型一致，未拖动不乱动）
		function syncStatusBarPos() {
			const sb = container.querySelector("#oml2d-statusBar");
			if (!sb) return;
			sb.style.bottom = "100px";
			sb.style.left = "0px";
			sb.style.top = "auto";
			sb.style.right = "auto";
		}
		// 按钮栏统一锚到容器右缘（最右位置），切换模型/加载后初始位置保持一致
		function syncMenusPos() {
			const menusEl = container.querySelector("#oml2d-menus");
			if (!menusEl) return;
			menusEl.style.left = container.offsetWidth + "px";
			menusEl.style.right = "auto";
		}
				// 欢迎语：模型加载成功后随机显示一条；同时把状态条锚到人物头顶
		if (tips.enable !== false && tips.welcomeMessage && tips.welcomeMessage.length) {
			oml2d.onLoad((status: string) => {
				if (status === "loading") {
					// 加载中：清除气泡避免位置乱动，状态栏锁定初始位置
					oml2d.clearTips();
					const sbL = container.querySelector<HTMLElement>("#oml2d-statusBar");
					if (sbL) {
						sbL.style.bottom = "100px";
						sbL.style.left = "0px";
						sbL.style.top = "auto";
						sbL.style.right = "auto";
					}
				} else if (status === "success") {
					const msg =
						tips.welcomeMessage[Math.floor(Math.random() * tips.welcomeMessage.length)];
					oml2d.tipsMessage(msg, 4000, 10);
					syncStatusBarPos();
					syncMenusPos();
				}
			});
		}
	
		// 按钮栏锚到容器右缘：菜单由库异步创建，延时轮询锚定，成功即停（不干扰后续拖动）
		let menusSyncTries = 0;
		const menusSyncTimer = window.setInterval(() => {
			menusSyncTries++;
			const menusEl = container.querySelector("#oml2d-menus");
			if (menusEl) {
				menusEl.style.left = container.offsetWidth + "px";
				menusEl.style.right = "auto";
				if (menusSyncTries >= 2) window.clearInterval(menusSyncTimer);
			}
			if (menusSyncTries > 8) window.clearInterval(menusSyncTimer);
		}, 500);

				// 窗口尺寸变化时重新判断移动端隐藏
		window.addEventListener("resize", () => applyResponsive());
	
		// ---- 人物可移动：按住人物/气泡/提示区域拖动，舞台、菜单、气泡、状态条整体平移 ----
		// 不拦截菜单按钮点击；位移超过阈值才视为拖动（保留模型点击交互）
		let dragState: {
			els: { el: HTMLElement; left: number; top: number }[];
			startX: number;
			startY: number;
			active: boolean;
		} | null = null;
		const DRAG_THRESHOLD = 6;
	
		function collectDragEls(): { el: HTMLElement; left: number; top: number }[] {
			const ids = ["oml2d-stage", "oml2d-menus", "oml2d-tips", "oml2d-statusBar"];
			return ids
				.map((id) => container.querySelector<HTMLElement>(`#${id}`))
				.filter((el): el is HTMLElement => !!el)
				.map((el) => {
					const r = el.getBoundingClientRect();
					return { el, left: r.left, top: r.top };
				});
		}
	
		// 整体平移（拖动 / 方向键共用）
		function moveWidgets(dx: number, dy: number) {
			for (const it of collectDragEls()) {
				it.el.style.left = `${it.left + dx}px`;
				it.el.style.top = `${it.top + dy}px`;
				it.el.style.right = "auto";
				it.el.style.bottom = "auto";
			}
		}
	
		// 拖动期间强制菜单保持显示
		// 库的隐藏逻辑绑定在 stage 元素上（stage.onmouseout → 菜单隐藏），拖动时鼠标可能移出 stage 触发隐藏
		let savedMenusOut: ((ev: MouseEvent) => void) | null = null;
		function forceMenusVisible() {
			const stageEl = container.querySelector<HTMLElement>("#oml2d-stage");
			if (!stageEl) return;
			savedMenusOut = stageEl.onmouseout;
			stageEl.onmouseout = null;
			// 菜单本身若已隐藏，强制显示
			const menusEl = container.querySelector<HTMLElement>("#oml2d-menus");
			if (menusEl) {
				menusEl.style.opacity = "1";
				menusEl.style.visibility = "visible";
			}
		}
		function restoreMenus() {
			const stageEl = container.querySelector<HTMLElement>("#oml2d-stage");
			if (!stageEl) return;
			stageEl.onmouseout = savedMenusOut;
			savedMenusOut = null;
		}
	
		// 方向键控制上下左右移动（10px/步）；输入框聚焦时不响应
		const MOVE_STEP = 10;
		window.addEventListener("keydown", (e) => {
			const keys = ["ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight"];
			if (!keys.includes(e.key)) return;
			const active = document.activeElement as HTMLElement | null;
			const tag = (active?.tagName || "").toLowerCase();
			if (tag === "input" || tag === "textarea" || active?.isContentEditable) return;
			e.preventDefault();
			let dx = 0;
			let dy = 0;
			if (e.key === "ArrowUp") dy = -MOVE_STEP;
			else if (e.key === "ArrowDown") dy = MOVE_STEP;
			else if (e.key === "ArrowLeft") dx = -MOVE_STEP;
			else if (e.key === "ArrowRight") dx = MOVE_STEP;
			moveWidgets(dx, dy);
		});
	
		// 捕获阶段：即使元素 fixed 定位超出容器视觉边界也能收到事件
		container.addEventListener(
			"pointerdown",
			(e) => {
				if ((e.target as HTMLElement).closest("#oml2d-menus")) return;
				dragState = {
					startX: e.clientX,
					startY: e.clientY,
					active: false,
					els: collectDragEls(),
				};
			},
			true,
		);
	
		window.addEventListener(
			"pointermove",
			(e) => {
				if (!dragState || !dragState.els.length) return;
				const dx = e.clientX - dragState.startX;
				const dy = e.clientY - dragState.startY;
				if (!dragState.active && Math.hypot(dx, dy) > DRAG_THRESHOLD) {
					dragState.active = true;
					forceMenusVisible();
				}
				if (!dragState.active) return;
				for (const it of dragState.els) {
					it.el.style.left = `${it.left + dx}px`;
					it.el.style.top = `${it.top + dy}px`;
					it.el.style.right = "auto";
					it.el.style.bottom = "auto";
				}
				e.preventDefault();
			},
			{ passive: false },
		);
	
		// 拖动结束后菜单保持显示一段时间，避免鼠标离开人物瞬间按钮栏消失
		let keepTimer: number | null = null;
		function keepMenusVisible(ms: number) {
			const stageEl = container.querySelector<HTMLElement>("#oml2d-stage");
			if (!stageEl) return;
			if (savedMenusOut === null && stageEl.onmouseout) {
				savedMenusOut = stageEl.onmouseout;
				stageEl.onmouseout = null;
			}
			const menusEl = container.querySelector<HTMLElement>("#oml2d-menus");
			if (menusEl) {
				menusEl.style.opacity = "1";
				menusEl.style.visibility = "visible";
			}
			if (keepTimer) window.clearTimeout(keepTimer);
			keepTimer = window.setTimeout(() => {
				restoreMenus();
				keepTimer = null;
			}, ms);
		}
		function endDrag() {
			if (dragState?.active) keepMenusVisible(3000);
			dragState = null;
		}
		window.addEventListener("pointerup", endDrag);
		window.addEventListener("pointercancel", endDrag);
	
		// 双击人物（mousedown 计数，350ms 内两次按下）：锁定/解锁按钮栏显示
		let menusLocked = false;
		let lockedMenusOut: ((ev: MouseEvent) => void) | null = null;
		let lockedTimer: number | null = null;
		let lastPointerDown = 0;
		container.addEventListener(
			"mousedown",
			(e) => {
				if ((e.target as HTMLElement).closest("#oml2d-menus")) return;
				const now = Date.now();
				if (now - lastPointerDown < 350) {
					lastPointerDown = 0;
					const stageEl = container.querySelector<HTMLElement>("#oml2d-stage");
					const menusEl = container.querySelector<HTMLElement>("#oml2d-menus");
					if (!stageEl || !menusEl) return;
					if (!menusLocked) {
						menusLocked = true;
						lockedMenusOut = stageEl.onmouseout;
						stageEl.onmouseout = null;
						menusEl.style.opacity = "1";
						menusEl.style.visibility = "visible";
						if (lockedTimer) window.clearInterval(lockedTimer);
						lockedTimer = window.setInterval(() => {
							if (menusLocked) {
								menusEl.style.opacity = "1";
								menusEl.style.visibility = "visible";
							}
						}, 400);
					} else {
						menusLocked = false;
						if (lockedTimer) { window.clearInterval(lockedTimer); lockedTimer = null; }
						stageEl.onmouseout = lockedMenusOut;
						lockedMenusOut = null;
						menusEl.style.opacity = "0";
						menusEl.style.visibility = "hidden";
					}
				} else {
					lastPointerDown = now;
				}
			},
			true,
		);
	
	}

	// 初次加载立即初始化；Swup 导航（astro:page-load）后重建
	if (document.getElementById("l2d-widget-container")) {
		initWidget();
		lastWidgetContainer = document.getElementById("l2d-widget-container");
	}
	document.addEventListener("astro:page-load", () => {
		const c = document.getElementById("l2d-widget-container");
		if (c && c !== lastWidgetContainer) {
			lastWidgetContainer = c;
			initWidget();
		}
	});
</script>
