---
import { getEntry, render } from "astro:content";
import Markdown from "@components/common/Markdown.astro";
import { Icon } from "astro-icon/components";
import MainGridLayout from "@/layouts/MainGridLayout.astro";

const contributePost = await getEntry("spec", "contribute");

if (!contributePost) {
	throw new Error("Contribute page content not found");
}

const { Content } = await render(contributePost);

const title = "投稿 / Contribute";
const description = "投稿请提 GitHub Issue 或 PR，稿件直接进入 git 审核流程";
---
<MainGridLayout title={title} description={description}>
	<div class="flex w-full rounded-(--radius-large) overflow-hidden relative min-h-32">
		<div class="card-base z-10 px-9 py-6 relative w-full">

			<Markdown class="mt-2">
				<Content />
			</Markdown>
		</div>
	</div>
</MainGridLayout>
